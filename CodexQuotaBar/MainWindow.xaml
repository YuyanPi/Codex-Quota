<Window x:Class="CodexQuotaBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota Bar"
        Icon="Assets/carrot.ico"
        Width="230" Height="146" MinWidth="230" MinHeight="146"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True"
        Closing="Window_Closing"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F2161A22"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF98A2B3"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFD8DEE9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="QuotaProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#FF343B49"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="打开主界面" Click="OpenMainWindow_Click"/>
            <MenuItem Header="缩小为悬浮球" Click="Compact_Click"/>
            <MenuItem Header="关闭悬浮功能" Click="DisableFloating_Click"/>
            <Separator/>
            <MenuItem Header="立即刷新" Click="Refresh_Click"/>
            <MenuItem x:Name="ContextTopmostItem" Header="取消置顶" Click="ToggleTopmost_Click"/>
            <MenuItem Header="退出" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
    <Border x:Name="MainSurface" Background="{StaticResource PanelBrush}" CornerRadius="10" BorderBrush="#FF303746" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.34" Color="#FF000000"/>
        </Border.Effect>
        <Grid Margin="10,5,8,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="18"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="↻" ToolTip="立即刷新" FontSize="16" Click="Refresh_Click"/>
                    <Button x:Name="TopmostButton" Content="◉" ToolTip="取消置顶" Click="ToggleTopmost_Click"/>
                    <Button Content="●" ToolTip="缩小为悬浮球" Click="Compact_Click"/>
                    <Button Content="×" ToolTip="关闭" FontSize="15" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="2,4,2,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="5h" Foreground="#FFD8DEE9" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" x:Name="FivePercentText" Text="--%" Foreground="#FFF5F7FA" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" x:Name="FiveResetText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </Grid>
                <ProgressBar x:Name="FiveProgress" Style="{StaticResource QuotaProgress}" Margin="0,7,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="2,4,2,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="周" Foreground="#FFD8DEE9" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" x:Name="WeekPercentText" Text="--%" Foreground="#FFF5F7FA" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" x:Name="WeekResetText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </Grid>
                <ProgressBar x:Name="WeekProgress" Style="{StaticResource QuotaProgress}" Margin="0,7,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="3" x:Name="UpdatedText" Foreground="#FF707A8C" FontSize="9"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="等待刷新"/>

            <Border Grid.Row="1" Grid.RowSpan="3" x:Name="MessagePanel" Background="#F2302525"
                    BorderBrush="#FF714747" BorderThickness="1" CornerRadius="7" Padding="7"
                    VerticalAlignment="Bottom" Visibility="Collapsed">
                <TextBlock x:Name="MessageText" Foreground="#FFFFB86C" FontSize="9" TextWrapping="Wrap" MaxHeight="38"/>
            </Border>
        </Grid>
    </Border>
    <Border x:Name="FloatingSurface" Width="48" Height="48" CornerRadius="24"
            Background="{StaticResource PanelBrush}" BorderBrush="#FF303746" BorderThickness="1"
            Visibility="Collapsed" MouseLeftButtonDown="FloatingSurface_MouseLeftButtonDown"
            MouseMove="FloatingSurface_MouseMove" MouseLeftButtonUp="FloatingSurface_MouseLeftButtonUp"
            MouseEnter="FloatingSurface_MouseEnter" MouseLeave="FloatingSurface_MouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.34" Color="#FF000000"/>
        </Border.Effect>
        <Border.ToolTip>
            <ToolTip Content="5h / 周"/>
        </Border.ToolTip>
        <Grid Margin="5,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="FloatingFiveText" Grid.Row="0" Text="--" FontSize="12" FontWeight="Bold"
                       Foreground="#FF788291" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border Grid.Row="1" Height="1" Background="#FF687384" Margin="5,0"/>
            <TextBlock x:Name="FloatingWeekText" Grid.Row="2" Text="--" FontSize="12" FontWeight="Bold"
                       Foreground="#FF788291" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
    </Grid>
</Window>

