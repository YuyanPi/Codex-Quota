<Window x:Class="CodexQuotaBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota Bar"
        Width="370" Height="630" MinWidth="340" MinHeight="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F0161A22"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF232936"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF98A2B3"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFD8DEE9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="QuotaProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#FF343B49"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" BorderBrush="#FF303746" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.42" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#FF10A37F">
                        <TextBlock Text="C" Foreground="White" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Codex 额度" Foreground="#FFF5F7FA" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Content="—" ToolTip="最小化" Click="Minimize_Click"/>
                    <Button Content="×" ToolTip="关闭" FontSize="18" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,8,18,12">
                    <Border Background="#FF1C212B" CornerRadius="12" Padding="15,13" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GPT 模型" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock x:Name="ModelText" Text="正在读取…" Foreground="#FFF5F7FA" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="RefreshButton" Content="↻" ToolTip="立即刷新" FontSize="22" Click="Refresh_Click"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="五小时额度剩余" Foreground="#FFD8DEE9" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FivePercentText" Text="--%" HorizontalAlignment="Right" Foreground="#FFF5F7FA" FontSize="22" FontWeight="Bold"/>
                            </Grid>
                            <ProgressBar x:Name="FiveProgress" Style="{StaticResource QuotaProgress}" Margin="0,14,0,12"/>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="FiveStatusDot" Width="8" Height="8" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="FiveStatusText" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock x:Name="FiveResetText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="周额度剩余" Foreground="#FFD8DEE9" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WeekPercentText" Text="--%" HorizontalAlignment="Right" Foreground="#FFF5F7FA" FontSize="22" FontWeight="Bold"/>
                            </Grid>
                            <ProgressBar x:Name="WeekProgress" Style="{StaticResource QuotaProgress}" Margin="0,14,0,12"/>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="WeekStatusDot" Width="8" Height="8" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="WeekStatusText" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock x:Name="WeekResetText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="MessagePanel" Background="#FF1C212B" CornerRadius="10" Padding="12" Visibility="Collapsed">
                        <TextBlock x:Name="MessageText" Foreground="#FFFFB86C" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="18,0">
                <TextBlock x:Name="SourceText" Foreground="#FF707A8C" FontSize="11" VerticalAlignment="Center" Text="等待首次刷新"/>
                <TextBlock x:Name="UpdatedText" Foreground="#FF707A8C" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
