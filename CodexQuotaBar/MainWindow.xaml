<Window x:Class="CodexQuotaBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota Bar"
        Width="300" Height="360" MinWidth="280" MinHeight="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F2161A22"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF232936"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF98A2B3"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFD8DEE9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="QuotaProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#FF343B49"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" BorderBrush="#FF303746" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.38" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="23" Height="23" CornerRadius="7" Background="#FF10A37F">
                        <TextBlock Text="C" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Codex 额度" Foreground="#FFF5F7FA" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,5,0">
                    <Button x:Name="TopmostButton" Content="◉" ToolTip="取消置顶" Click="ToggleTopmost_Click"/>
                    <Button Content="—" ToolTip="最小化" Click="Minimize_Click"/>
                    <Button Content="×" ToolTip="关闭" FontSize="16" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="12,4,12,5">
                <StackPanel>
                    <Border Background="#FF1C212B" CornerRadius="9" Padding="10,7" Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GPT 模型 · 共用账户额度" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                <TextBlock x:Name="ModelText" Text="正在读取…" Foreground="#FFF5F7FA" FontSize="14" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="RefreshButton" Content="↻" ToolTip="立即刷新" FontSize="19" Click="Refresh_Click"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="11,9" Margin="0,0,0,7">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="五小时额度" Foreground="#FFD8DEE9" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FivePercentText" Text="--%" HorizontalAlignment="Right" Foreground="#FFF5F7FA" FontSize="18" FontWeight="Bold"/>
                            </Grid>
                            <ProgressBar x:Name="FiveProgress" Style="{StaticResource QuotaProgress}" Margin="0,7,0,7"/>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="FiveStatusDot" Width="7" Height="7" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="FiveStatusText" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                                <TextBlock x:Name="FiveResetText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="11,9">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="周额度" Foreground="#FFD8DEE9" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WeekPercentText" Text="--%" HorizontalAlignment="Right" Foreground="#FFF5F7FA" FontSize="18" FontWeight="Bold"/>
                            </Grid>
                            <ProgressBar x:Name="WeekProgress" Style="{StaticResource QuotaProgress}" Margin="0,7,0,7"/>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="WeekStatusDot" Width="7" Height="7" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="WeekStatusText" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                                <TextBlock x:Name="WeekResetText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="MessagePanel" Background="#F2302525" BorderBrush="#FF714747" BorderThickness="1" CornerRadius="8" Padding="8" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" Foreground="#FFFFB86C" FontSize="10" TextWrapping="Wrap" MaxHeight="42"/>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="12,0">
                <TextBlock x:Name="SourceText" Foreground="#FF707A8C" FontSize="9" VerticalAlignment="Center" Text="等待刷新"/>
                <TextBlock x:Name="UpdatedText" Foreground="#FF707A8C" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
