<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexQuotaBar</AssemblyName>
    <RootNamespace>CodexQuotaBar</RootNamespace>
    <ApplicationIcon>Assets\carrot.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\carrot.ico" />
  </ItemGroup>
</Project>
